# Postgres used by the app and `npm run db:seed`.
DATABASE_URL=postgres://postgres@127.0.0.1:54333/revenue_signal
# Postgres used by `npm test` (reset on every test).
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54333/revenue_signal_test
# Shared secret for POST /api/ingest/:source. Change it anywhere but your laptop.
INGEST_API_KEY=dev-ingest-key
